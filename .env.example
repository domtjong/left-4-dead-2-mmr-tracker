# Copy to .env.local and fill in. Never commit real values.

# Supabase project — public, compiled into the client bundle (read-only under RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — do NOT prefix with NEXT_PUBLIC_ (would leak to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # match writes bypass RLS via this
MATCH_PIN=your-shared-write-pin                    # gate for logging/deleting matches

# Local scripts only — direct Postgres connection (migrations / recompute)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
